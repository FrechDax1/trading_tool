# Konfiguration für dump_schema.sh
#
# Zugangsdaten (Host/User/Passwort) stehen HIER NICHT drin — die kommen aus
# deiner MySQL-Optionsdatei (Standard: ~/.my.cnf), die mysql/mysqldump
# automatisch einlesen.
#
# Diese Datei ist nur die Vorlage. Kopiere sie zu ".env" (im selben Ordner),
# falls du den Datenbanknamen nicht jedes Mal als Argument übergeben willst:
#
#   cp .env.example .env
 
# Name der Datenbank (kein Geheimnis, kann also auch im Repo landen, wenn du magst)
DB_NAME=u903087946_Q4Y 
 
# Nur setzen, falls deine Optionsdatei NICHT am Standardpfad ~/.my.cnf liegt
# (z.B. falls sie wirklich "~/.mycnf" ohne Punkt heißt):
# MYCNF_FILE=~/.my.cnf
